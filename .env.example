APP_NAME=Laravel
APP_ENV=local
# Use production on UNRAID.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

SPA_URL=http://localhost:5173/
LANDING_URL=http://localhost:4321/
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:4321
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

PRODUCT_IMPORT_JSON_PATH=storage/app/import/productos_normalizados.json

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BASE_URL=
OPENAI_REQUEST_TIMEOUT=30
OPENAI_OCR_MODEL=gpt-4o-mini

# OCR_PROVIDER puede ser: ollama_service, ollama, azure u openai.
# Recomendado: ollama_service usa el microservicio Python con Ollama-OCR + OpenCV.
OCR_PROVIDER=ollama_service
OCR_SERVICE_URL=http://ocr-service:8000
OCR_SERVICE_TIMEOUT=240
OCR_PREPROCESS=true
OCR_FALLBACK_NO_PREPROCESS=true
OCR_LANGUAGE=Spanish
OCR_MAX_IMAGE_EDGE=1600
OLLAMA_NUM_PREDICT=768
OLLAMA_HTTP_TIMEOUT=180

# Para el microservicio OCR o para el modo directo OCR_PROVIDER=ollama:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_OCR_MODEL=llama3.2-vision:11b
OLLAMA_REQUEST_TIMEOUT=180

# OCR con Azure OpenAI / Azure AI Foundry.
# Si completas alguna AZURE_OPENAI_*, completa las tres.
# AZURE_OPENAI_DEPLOYMENT es el nombre del deployment/model deployment, no el nombre visible del recurso.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
